def fetch_url(url):
    """Fetch URL with timeout and error handling."""
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "HulbertMacroScreen/1.0"})
        with urllib.request.urlopen(req, timeout=30) as response:
            return json.loads(response.read().decode("utf-8"))
    except Exception as e:
        print(f"  Error fetching {url[:80]}...: {e}", file=sys.stderr)
        return None

def fetch_worldbank(indicator, country_codes):
    """
    Fetch most recent value for an indicator from World Bank API.
    Returns dict: {iso2: {"value": float, "date": "YYYY"}}
    """
    codes = ";".join(country_codes)
    url = (f"https://api.worldbank.org/v2/country/{codes}/indicator/{indicator}"
           f"?format=json&mrv=5&per_page=500")
    
    data = fetch_url(url)
    if not data or len(data) < 2 or not data[1]:
        return {}
    
    result = {}
    for item in data[1]:
        if item.get("value") is None:
            continue
        # Use countryiso3code if available, fallback to country id
        iso2 = item.get("country", {}).get("id", "")
        if not iso2:
            continue
        # Keep most recent non-null value
        if iso2 not in result:
            result[iso2] = {
                "value": round(float(item["value"]), 2),
                "date": item.get("date", "")
            }
    return result

def load_pe_data():
    """Load PE data from pe_data.json."""
    pe_file = os.path.join(os.path.dirname(__file__), "..", "pe_data.json")
    try:
        with open(pe_file, "r") as f:
            return json.load(f)
    except Exception as e:
        print(f"Warning: Could not load pe_data.json: {e}", file=sys.stderr)
        return {}

def load_existing_data():
    """Load existing hulbert_data.json to use as fallback."""
    data_file = os.path.join(os.path.dirname(__file__), "..", "hulbert_data.json")
    try:
        with open(data_file, "r") as f:
            return json.load(f)
    except Exception:
        return {}

def main():
    print("Fetching macro data from World Bank API...")
    
    wb_codes = [c["wb"] for c in COUNTRIES]
    
    # ── Fetch CPI (inflation) ─────────────────────────────────────────────────
    print("  → CPI (inflation) FP.CPI.TOTL.ZG")
    cpi_data = fetch_worldbank("FP.CPI.TOTL.ZG", wb_codes)
    print(f"     Got {len(cpi_data)} countries")

    # ── Fetch Unemployment ────────────────────────────────────────────────────
    print("  → Unemployment SL.UEM.TOTL.ZS")
    unemp_data = fetch_worldbank("SL.UEM.TOTL.ZS", wb_codes)
    print(f"     Got {len(unemp_data)} countries")

    # ── Load PE data ──────────────────────────────────────────────────────────
    pe_data = load_pe_data()
    pe_updated = pe_data.get("_updated", "unknown")
    print(f"  → PE data loaded (updated: {pe_updated})")

    # ── Load existing data for fallback ───────────────────────────────────────
    existing = load_existing_data()

    # ── Assemble output ───────────────────────────────────────────────────────
    today = datetime.utcnow().strftime("%Y-%m-%d")
    output = {
        "_updated": today,
        "_sources": {
            "cpi": "World Bank API — FP.CPI.TOTL.ZG (annual CPI %)",
            "unemployment": "World Bank API — SL.UEM.TOTL.ZS (% of total labour force)",
            "pe": f"Manual update from etf.com — last updated {pe_updated}",
            "note": "Each metric shows its own reference date. World Bank data may lag 1-2 years for some countries."
        }
    }

    for c in COUNTRIES:
        etf = c["etf"]
        wb  = c["wb"]

        cpi_entry   = cpi_data.get(wb)
        unemp_entry = unemp_data.get(wb)
        pe_val      = pe_data.get(etf)

        # Fallback to existing data if API returned nothing
        existing_etf = existing.get(etf, {})
        
        if cpi_entry is None and existing_etf.get("cpi") is not None:
            cpi_entry = {
                "value": existing_etf["cpi"],
                "date": existing_etf.get("cpi_date", "cached")
            }
            print(f"  ⚠ {etf} CPI: using cached value ({cpi_entry['value']})")

        if unemp_entry is None and existing_etf.get("unemp") is not None:
            unemp_entry = {
                "value": existing_etf["unemp"],
                "date": existing_etf.get("unemp_date", "cached")
            }
            print(f"  ⚠ {etf} Unemp: using cached value ({unemp_entry['value']})")

        output[etf] = {
            "country":    c["country"],
            "region":     c["region"],
            "cpi":        cpi_entry["value"]  if cpi_entry   else None,
            "cpi_date":   cpi_entry["date"]   if cpi_entry   else None,
            "unemp":      unemp_entry["value"] if unemp_entry else None,
            "unemp_date": unemp_entry["date"]  if unemp_entry else None,
            "pe":         float(pe_val) if pe_val not in (None, "", "_updated", "_source") else None,
            "pe_date":    pe_updated,
        }

    # ── Write output ──────────────────────────────────────────────────────────
    out_file = os.path.join(os.path.dirname(__file__), "..", "hulbert_data.json")
    with open(out_file, "w", encoding="utf-8") as f:
        json.dump(output, f, indent=2, ensure_ascii=False)
    
    print(f"\n✅ hulbert_data.json written — {len(COUNTRIES)} countries")
    
    # ── Summary ───────────────────────────────────────────────────────────────
    has_cpi   = sum(1 for c in COUNTRIES if output[c["etf"]]["cpi"]   is not None)
    has_unemp = sum(1 for c in COUNTRIES if output[c["etf"]]["unemp"] is not None)
    has_pe    = sum(1 for c in COUNTRIES if output[c["etf"]]["pe"]    is not None)
    print(f"   CPI:          {has_cpi}/{len(COUNTRIES)} countries")
    print(f"   Unemployment: {has_unemp}/{len(COUNTRIES)} countries")
    print(f"   P/E:          {has_pe}/{len(COUNTRIES)} countries")

if __name__ == "__main__":
    main()
